{
  "vendor": "openclaw/openclaw",
  "release": "2026.7.1-2",
  "instance": {
    "harness": "openclaw",
    "surface": "gateway-embedded",
    "execHost": "gateway"
  },
  "durableSessionKey": "agent:main:main",
  "rotatingSessionId": "session-generation-not-identity",
  "observedPluginEnv": {
    "NOTIFAI_ACTIVE_HARNESS": "openclaw",
    "NOTIFAI_ACTIVE_SESSION_ID": "agent:main:main"
  },
  "hooks": {
    "activation": "before_prompt_build",
    "presence": "message_received",
    "stop": "agent_end",
    "sessionEnd": "session_end",
    "execMarkers": "resolve_exec_env"
  },
  "worker": {
    "sessionKeySubstring": ":subagent:",
    "acpTargetKind": "acp",
    "missingIdentity": "fail-closed-worker"
  },
  "supported": [
    "managed-setup",
    "lifecycle-activation",
    "source-context-from-session-key"
  ],
  "unsupported": [
    "question-routing",
    "command-stop-as-turn-end",
    "2026.2.26-cli"
  ]
}
