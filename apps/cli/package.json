{
  "name": "@raidiant/notifai",
  "version": "14.2.3",
  "type": "module",
  "description": "Notifications and questions from your coding agents to your phone. Your answer goes back to the exact session that asked. Claude Code, Codex, Cursor, OpenCode, OpenClaw, Hermes and Grok.",
  "bin": {
    "notifai": "dist/main.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-shipped-skill.mjs && node ../../scripts/chmod-cli-bin.mjs",
    "pretest": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-cli-tests.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@raidiant/notifai-protocol": "9.1.2",
    "@zip.js/zip.js": "2.23.0",
    "commander": "^14.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "qrcode": "1.5.4",
    "smol-toml": "^1.9.0",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "cmd-shim": "8.0.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.11",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "license": "Apache-2.0",
  "author": "Rafael Vidaurre",
  "homepage": "https://notifai.sh",
  "bugs": {
    "url": "https://github.com/Raidiant-io/notifai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raidiant-io/notifai.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "openclaw",
    "hermes",
    "grok",
    "coding-agent",
    "ai-agents",
    "agentic-coding",
    "agent-skills",
    "claude-code-hooks",
    "notifications",
    "push-notifications",
    "mobile-notifications",
    "phone",
    "ios",
    "android",
    "cli",
    "developer-tools"
  ]
}
